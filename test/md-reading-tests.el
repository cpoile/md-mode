;;; md-reading-tests.el --- Reading column regression tests -*- lexical-binding: t; -*-

;; SPDX-License-Identifier: GPL-3.0-or-later

;;; Commentary:

;; Exercise source preservation, table exceptions and window-local layout.

;;; Code:

(require 'cl-lib)
(require 'ert)
(require 'md-mode)

(defconst md-reading-tests--source
  (concat "# A long heading with **bold** and a [link](https://example.com)\n\n"
          "- A long list item with enough words to wrap several times in a narrow reading column.\n\n"
          "A paragraph with **bold**, *italic*, `code`, and enough ordinary words to wrap.\n\n"
          "| Name | Description |\n| --- | --- |\n| Alpha | A wide table cell |\n\n"
          "```text\nA long line of code with enough words to need wrapping as well.\n```\n")
  "Markdown fixture with prose, a table and a source block.")

(ert-deftest md-reading-keeps-markdown-and-full-width-tables ()
  (save-window-excursion
    (with-temp-buffer
      (set-window-buffer (selected-window) (current-buffer))
      (insert md-reading-tests--source)
      (md-mode)
      (set-buffer-modified-p nil)
      (let ((md-reading-width 35)
            (md-reading-padding 2)
            (md-render-wrap-lines t)
            (md-render-table-wrap-columns t))
        (md-mode-render)
        (should (equal (md-render-reconstruct (point-min) (point-max))
                       md-reading-tests--source))
        (should-not (buffer-modified-p))
        (should (cl-some (lambda (overlay)
                           (equal (overlay-get overlay 'display) "\n"))
                         (overlays-in (point-min) (point-max))))
        (goto-char (point-min))
        (search-forward "Alpha")
        (should (get-text-property (1- (point)) 'md-render-table-source))
        (should-not (cl-some (lambda (overlay)
                               (overlay-get overlay 'md-reading))
                             (overlays-at (1- (point)))))
        (should (= md-mode--table-widget-width (window-body-width)))
        (md-mode-show-source)
        (should (equal (buffer-string) md-reading-tests--source))
        (should-not md-reading--layouts)
        (should-not md-reading--font-remaps)))))

(ert-deftest md-reading-fonts-are-independent-and-buffer-local ()
  (with-temp-buffer
    (let ((md-reading-font-family "Atkinson Hyperlegible Next")
          (md-reading-font-weight 'normal)
          (md-reading-text-point-increase 2)
          (md-reading-table-point-increase 1)
          (original face-remapping-alist))
      (md-reading-prepare)
      (let* ((prose (cadr (assq 'default face-remapping-alist)))
             (table (cadr (assq 'fixed-pitch face-remapping-alist)))
             (base (face-attribute 'default :height nil t)))
        (should (equal (plist-get prose :family) md-reading-font-family))
        (should (equal (plist-get table :family) md-reading-font-family))
        (should (eq (plist-get prose :weight) 'normal))
        (should (= (funcall (plist-get prose :height) base) (+ base 20)))
        (should (= (funcall (plist-get prose :height) 'unspecified) (+ base 20)))
        (should (= (plist-get table :height) (+ base 10)))
        (let ((cookies md-reading--font-remaps))
          (md-reading-prepare)
          (should (equal cookies md-reading--font-remaps))))
      (md-reading-clear)
      (should (equal original face-remapping-alist)))))

(ert-deftest md-reading-stripes-follow-the-background-and-restore-cleanly ()
  (with-temp-buffer
    (let ((md-reading-table-stripe-darkening 0.5)
          (original face-remapping-alist))
      (cl-letf (((symbol-function 'face-background)
                 (lambda (&rest _) "#80A0C0")))
        (should (equal (md-reading--stripe-background) "#405060"))
        (md-reading-prepare)
        (should (equal (plist-get (cadr (assq 'md-render-table-zebra
                                             face-remapping-alist))
                                  :background)
                       "#405060")))
      (md-reading-clear)
      (should (equal face-remapping-alist original)))))

(ert-deftest md-reading-resize-replaces-overlays-without-editing-text ()
  (save-window-excursion
    (with-temp-buffer
      (set-window-buffer (selected-window) (current-buffer))
      (insert "A long paragraph with many ordinary words to wrap in the reading column.\n")
      (set-buffer-modified-p nil)
      (let ((md-reading-width 35)
            (md-reading-padding 2))
        (md-reading-prepare)
        (md-reading-apply)
        (let ((overlays (copy-sequence (cddr (car md-reading--layouts))))
              (text (buffer-string)))
          (cl-letf (((symbol-function 'window-body-width)
                     (lambda (&rest _) 25)))
            (md-reading--window-change (selected-window)))
          (should (cl-every (lambda (overlay)
                              (null (overlay-buffer overlay))) overlays))
          (should (equal (buffer-string) text))
          (should-not (buffer-modified-p))
          (should (= (length md-reading--layouts) 1))
          (should (= (caadr (car md-reading--layouts)) 25)))
        (md-reading-clear)))))

(ert-deftest md-reading-styles-restore-source-spacing-and-link-mappings ()
  (dolist (local '(nil t))
    (with-temp-buffer
      (let ((md-reading-line-spacing 0.15)
            (md-reading-bold-color "#C19CA7")
            (md-reading-plain-links t)
            (old-link '(md-render-link markdown-link-face md-render-link)))
        (setq-local face-remapping-alist (list old-link))
        (when local (setq-local line-spacing 3))
        (let ((spacing line-spacing))
          (md-reading-prepare)
          (should (= line-spacing 0.15))
          (let ((style (cadr (assq 'md-render-link face-remapping-alist))))
            (should (eq (plist-get style :weight) 'normal))
            (should (plist-get style :underline))
            (should-not (plist-member style :background))
            (should-not (plist-member style :inherit)))
          (should (equal (plist-get (cadr (assq 'md-render-bold
                                               face-remapping-alist))
                                    :foreground)
                         "#C19CA7"))
          (md-reading-clear)
          (should (eq (assq 'md-render-link face-remapping-alist) old-link))
          (should (equal line-spacing spacing))
          (should (eq (local-variable-p 'line-spacing) local)))))))

(ert-deftest md-reading-plain-links-do-not-change-other-buffers ()
  (let ((global (default-value 'face-remapping-alist)))
    (with-temp-buffer
      (let ((md-reading-plain-links t))
        (md-reading-prepare)
        (should (equal (default-value 'face-remapping-alist) global))
        (md-reading-clear)
        (should-not (assq 'md-render-link face-remapping-alist))))))

(ert-deftest md-reading-scopes-layout-to-each-window ()
  (save-window-excursion
    (with-temp-buffer
      (insert "A paragraph long enough to wrap at the selected reading width.\n")
      (set-window-buffer (selected-window) (current-buffer))
      (let* ((first (selected-window))
             (second (split-window-right))
             (md-reading-width 20)
             (md-reading-padding 1))
        (set-window-buffer second (current-buffer))
        (md-reading-prepare)
        (md-reading-apply)
        (should (= (length md-reading--layouts) 2))
        (dolist (window (list first second))
          (dolist (overlay (cddr (assq window md-reading--layouts)))
            (should (eq (overlay-get overlay 'window) window))))
        (md-reading-clear)))))

(ert-deftest md-reading-wraps-unbroken-words-without-replacing-them ()
  (save-window-excursion
    (with-temp-buffer
      (set-window-buffer (selected-window) (current-buffer))
      (insert (make-string 120 ?x))
      (let ((md-reading-width 20)
            (md-reading-padding 1))
        (md-reading-prepare)
        (md-reading-apply)
        (should (cl-some (lambda (overlay)
                           (equal (overlay-get overlay 'before-string) "\n"))
                         (overlays-in (point-min) (point-max))))
        (should (equal (buffer-string) (make-string 120 ?x)))
        (md-reading-clear)))))

(ert-deftest md-reading-render-failure-restores-fonts ()
  (with-temp-buffer
    (insert "Text\n")
    (md-mode)
    (let ((md-reading-font-family "Atkinson Hyperlegible Next")
          (original face-remapping-alist))
      (cl-letf (((symbol-function 'md-render-replace-markup)
                 (lambda (&rest _) (error "Rendering failed"))))
        (should-error (md-mode-render)))
      (should-not md-reading--active)
      (should-not md-reading--font-remaps)
      (should (equal original face-remapping-alist)))))

(ert-deftest md-reading-invalidates-table-measurements-before-rendering ()
  (with-temp-buffer
    (insert "Text\n")
    (md-mode)
    (setq md-render--table-char-pixel-cache '(8 . 8)
          md-render--table-widget-measure-cache '(old-font . nil)
          md-render--table-face-width-cache (make-hash-table))
    (cl-letf (((symbol-function 'md-render-replace-markup)
               (lambda (&rest _)
                 (should-not md-render--table-char-pixel-cache)
                 (should-not md-render--table-widget-measure-cache)
                 (should-not md-render--table-face-width-cache))))
      (md-mode-render))
    (md-mode-show-source)))

(ert-deftest md-reading-gui-keeps-prose-inside-the-column ()
  (skip-unless (display-graphic-p))
  (save-window-excursion
    (with-temp-buffer
      (set-window-buffer (selected-window) (current-buffer))
      (insert "A paragraph with a **bold span**, a [link](https://example.com), and an unbroken word: "
              (make-string 120 ?x) ".\n")
      (let ((md-mode-hook nil)
            (md-render-view-mode-hook nil)
            (md-reading-width 240)
            (md-reading-font-family "Atkinson Hyperlegible Next")
            (md-render-wrap-lines t))
        (md-mode)
        (md-mode-render)
        (goto-char (point-min))
        (redisplay t)
        (let ((left (car (posn-x-y (posn-at-point (point-min)))))
              (positions nil))
          (while (not (eobp))
            (when-let* ((position (posn-at-point (point)))
                        (xy (posn-x-y position)))
              (unless (memq (char-after) '(?\s ?\n))
                (push xy positions)))
            (forward-char 1))
          (should (> (length (delete-dups (mapcar #'cdr positions))) 1))
          (dolist (xy positions)
            (should (>= (car xy) left))
            (should (<= (car xy) (+ left md-reading-width)))))))))

(ert-deftest md-reading-code-blocks-retain-the-frame-font ()
  (with-temp-buffer
    (let ((md-reading-font-family "Atkinson Hyperlegible Next")
          (md-reading-font-weight 'normal)
          (md-reading-text-point-increase 2))
      (md-reading-prepare)
      (dolist (face '(md-render-source-block md-render-source-block-language))
        (let ((remap (cadr (assq face face-remapping-alist))))
          (dolist (attribute '(:family :height :weight))
            (should (equal (plist-get remap attribute)
                           (face-attribute 'default attribute nil t))))))
      (md-reading-clear))))

(ert-deftest md-reading-gui-fills-table-width-and-separates-code-font ()
  (skip-unless (display-graphic-p))
  (skip-unless (find-font (font-spec :family "Atkinson Hyperlegible Next")))
  (save-window-excursion
    (with-temp-buffer
      (set-window-buffer (selected-window) (current-buffer))
      (insert "Plain prose with **bold** and [a link](https://example.com).\n\n| First | Second | Third |\n| --- | --- | --- |\n| "
              (apply #'concat (make-list 25 "long table content ")) " | "
              (apply #'concat (make-list 25 "more table content ")) " | "
              (apply #'concat (make-list 25 "other table content "))
              " |\n\n```text\nplain_code_block\n```\n")
      (let ((md-mode-hook nil)
            (md-render-view-mode-hook nil)
            (md-reading-width 760)
            (md-reading-font-family "Atkinson Hyperlegible Next")
            (md-reading-font-weight 'normal)
            (md-reading-text-point-increase 5)
            (md-reading-table-point-increase 2)
            (md-reading-table-stripe-darkening 0.08)
            (md-reading-line-spacing 0.15)
            (md-reading-bold-color "#C19CA7")
            (md-reading-plain-links t)
            (md-render-wrap-lines t)
            (md-render-table-wrap-columns t))
        (md-mode)
        (md-mode-render)
        (goto-char (point-min))
        (redisplay t)
        (let* ((window (selected-window))
               (normal (font-get (find-font (font-spec :weight 'normal)) :weight))
               (prose (font-at (point-min) window))
               (rule (save-excursion
                       (search-forward "First")
                       (forward-line -1)
                       (buffer-substring (line-beginning-position)
                                         (line-end-position))))
               (pixels (string-pixel-width rule (current-buffer))))
          (should (equal (font-get prose :weight) normal))
          (should (= (font-get prose :size)
                     (+ (/ (face-attribute 'default :height nil t) 10) 5)))
          (should (<= (abs (- pixels (window-body-width window t))) 2))
          (should (= line-spacing 0.15))
          (search-forward "a link")
          (should (equal (font-get (font-at (1- (point)) window) :weight) normal))
          (should (equal (get-text-property (1- (point)) 'md-render-url)
                         "https://example.com"))
          (search-forward "long table content")
          (should (equal (font-get (font-at (1- (point)) window) :weight) normal))
          (should (= (font-get (font-at (1- (point)) window) :size)
                     (+ (/ (face-attribute 'default :height nil t) 10) 2)))
          (search-forward "plain_code_block")
          (recenter)
          (redisplay t)
          (let ((code (font-at (1- (point)) window)))
            (should (equal (format "%s" (font-get code :family))
                           (face-attribute 'default :family nil t)))
            (should (= (font-get code :size)
                       (/ (face-attribute 'default :height nil t) 10)))))))))

(provide 'md-reading-tests)

